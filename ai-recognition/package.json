{
  "name": "howtune-ai-recognition",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @howtune/collect-web",
    "dev:collect": "npm run dev -w @howtune/collect-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ml:train": "npm run train -w @howtune/ml",
    "ml:evaluate": "npm run evaluate -w @howtune/ml",
    "ml:predict": "npm run predict -w @howtune/ml"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "tar": "^7.5.15"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
